# Frontend configuration — copy to frontend/.env and adjust.
# Vite only exposes variables prefixed with VITE_, and anything here is public:
# never put a secret in this file or in .env.

# Django REST base URL. Leave it unset to use the /api proxy in vite.config.js.
VITE_API_BASE_URL=http://127.0.0.1:8000/api

# Optional public profile links for the footer. A variable that is empty or
# missing hides its icon entirely, so no link ever points at someone else's page.
VITE_SOCIAL_GITHUB_URL=
VITE_SOCIAL_LINKEDIN_URL=
VITE_SOCIAL_COMMUNITY_URL=
VITE_SOCIAL_FEED_URL=
