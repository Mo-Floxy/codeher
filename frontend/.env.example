# Frontend configuration — copy to frontend/.env and adjust.
# Vite only exposes variables prefixed with VITE_, and anything here is public:
# never put a secret in this file or in .env.

# Django REST base URL — the only knob the frontend needs, and the default is right.
#
# Leave it UNSET. The app calls same-origin /api, and whoever serves the frontend
# proxies it: vite.config.js for `npm run dev` and `npm run preview`, vercel.json in
# production. Point the dev/preview proxy at a different backend with
# VITE_PROXY_TARGET=http://127.0.0.1:8000 in this file.
#
# Set this only if you want the browser to call the API cross-origin instead — then add
# the site's origin to the backend's CORS_ALLOWED_ORIGINS.
VITE_API_BASE_URL=

# Optional public profile links for the footer. A variable that is empty or
# missing hides its icon entirely, so no link ever points at someone else's page.
VITE_SOCIAL_GITHUB_URL=
VITE_SOCIAL_LINKEDIN_URL=
VITE_SOCIAL_COMMUNITY_URL=
VITE_SOCIAL_FEED_URL=
