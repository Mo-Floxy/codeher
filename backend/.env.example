# CodeHer backend configuration — copy to .env and fill in real values.
# Never commit .env. Never mirror these secrets into the frontend.

DJANGO_SECRET_KEY=replace-with-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost,testserver
DJANGO_TIME_ZONE=UTC
DJANGO_LOG_LEVEL=INFO
DJANGO_CSRF_TRUSTED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
FRONTEND_ORIGIN=http://127.0.0.1:5173

# mysql (default) or sqlite. Use sqlite only for a quick local smoke test.
# TiDB Cloud Starter speaks the MySQL protocol, so it uses this same block.
DB_ENGINE=mysql
MYSQL_DATABASE=codeher
MYSQL_USER=codeher_app
MYSQL_PASSWORD=set-during-database-setup
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
# Serverless databases wake slowly and idle connections die without warning; these
# turn a cold start into a fast error and a closed connection into a reconnect.
MYSQL_CONNECT_TIMEOUT=10
MYSQL_READ_TIMEOUT=30
MYSQL_WRITE_TIMEOUT=30
# TiDB Cloud publishes its own CA bundle for the free "Starter" tier — download it,
# point MYSQL_SSL_CA at the file (or the certificate text) and keep hostname checking
# on. MYSQL_SSL is for a MySQL server that wants TLS but hands out no custom CA.
MYSQL_SSL=False
MYSQL_SSL_CA=
MYSQL_SSL_CHECK_HOSTNAME=True
# Reused connections to a serverless proxy get closed under us, so 0 is the safe value
# in production. Settings already enable CONN_HEALTH_CHECKS for that reason.
MYSQL_CONN_MAX_AGE=60

# Auth tokens
JWT_SIGNING_KEY=replace-with-a-second-long-random-string
JWT_ACCESS_MINUTES=30
JWT_REFRESH_MINUTES=20160

# CORS
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Isolated code runner (a separate Node service on 8090, never inside Django)
RUNNER_BASE_URL=http://127.0.0.1:8090
RUNNER_SHARED_SECRET=change-me-and-match-runner-env
RUNNER_TIMEOUT_SECONDS=12
RUNNER_MAX_CODE_BYTES=20000

# Media
MEDIA_ROOT=
MEDIA_URL=/media/
# Uploaded avatars and project screenshots are files, not database rows. Render's free
# instance filesystem is wiped on every deploy, so only set this to True with a
# persistent disk attached — otherwise the rows survive and the files 404.
SERVE_MEDIA_IN_PRODUCTION=False

# Password reset email. Leave the console backend in DEBUG to print links instead of sending.
DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=CodeHer <no-reply@codeher.local>
PASSWORD_RESET_TIMEOUT_HOURS=24

# Gamification tuning (XP awarded per verified action)
XP_LESSON=20
XP_QUIZ_PASS=40
XP_COURSE=150
XP_PROJECT=60
XP_MENTOR_MATCH=50

# ---------------------------------------------------------------- deploying
# See render.yaml for the full service definition. On Render the values above become:
#   DJANGO_DEBUG=False
#   DJANGO_ALLOWED_HOSTS=<service>.onrender.com
#   CORS_ALLOWED_ORIGINS=https://<project>.vercel.app   (skip if Vercel proxies /api)
#   DJANGO_CSRF_TRUSTED_ORIGINS=https://<project>.vercel.app
#   FRONTEND_ORIGIN=https://<project>.vercel.app        (password-reset links point here)
#   RUNNER_BASE_URL=https://<runner-service>.onrender.com
#   RUNNER_SHARED_SECRET must equal the runner service's own value or every /run is 401.
# Set these in the Render dashboard, never in this file — render.yaml marks them
# `sync: false` so the blueprint asks for them instead of committing them.

# The 0003 migrations that add the unique indexes refuse to run if duplicate rows
# already exist, rather than deleting data silently. After reviewing the duplicates it
# lists, set this to 1 once to let the migration proceed:
# CODEHER_ALLOW_DEDUPE=1
