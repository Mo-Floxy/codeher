# Copy to .env (same folder) and adjust. Never commit the real secret.

# Must be byte-for-byte identical to RUNNER_SHARED_SECRET in backend/.env.
RUNNER_SHARED_SECRET=change-me-to-match-the-backend

# The runner binds to localhost only. Do not expose it to a network.
RUNNER_HOST=127.0.0.1
RUNNER_PORT=8090

# Absolute path to a real Python interpreter. On Windows the bare `python`
# command is frequently the Microsoft Store alias, which starts nothing and
# makes every submission time out. Point this at your interpreter, e.g.
# PYTHON_BIN=C:\codeher\backend\.venv\Scripts\python.exe
PYTHON_BIN=python

# Submissions larger than this are rejected before execution.
RUNNER_MAX_CODE_BYTES=20000
